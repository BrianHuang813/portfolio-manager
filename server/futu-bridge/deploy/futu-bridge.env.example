# Copy to /etc/futu-bridge.env (chmod 600). Read by futu-bridge.service.

# Shared secret the dashboard sends as "Authorization: Bearer ..." — generate with: openssl rand -hex 32
BRIDGE_TOKEN=

# Dashboard origin(s) allowed by CORS, comma-separated, no trailing slash
ALLOWED_ORIGINS=https://your-dashboard.vercel.app

# The plain key; FutuOpenD.xml's <websocket_key_md5> must be its MD5 (echo -n KEY | md5sum)
FUTU_WEBSOCKET_KEY=

OPEND_HOST=127.0.0.1
OPEND_WS_PORT=33333
HOST=127.0.0.1
PORT=8787
CACHE_SECONDS=30
